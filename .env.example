# ── Database Credentials ──────────────────────────────────────────────────────
POSTGRES_DB=parkit
POSTGRES_USER=parkit_user
POSTGRES_PASSWORD=change_me_db_password
DB_PORT=5432

# ── JWT Configuration ─────────────────────────────────────────────────────────
# Must be at least 32 characters long. In production, generate with: openssl rand -base64 48
JWT_SECRET=super_secure_random_jwt_secret_parkit_production_key_2026_xyz
JWT_EXPIRES_IN=12h

# ── Server Configuration ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=5173

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Security & Cryptography ───────────────────────────────────────────────────
# MFA AES-256 key: must be exactly 64 hexadecimal characters (32 bytes).
# Generate with: openssl rand -hex 32
MFA_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Obfuscated route for downloading the Android operator APK
# Must start with '/' and contain an unpredictable path
APK_DOWNLOAD_SECRET_PATH=/distribution/d9f8e7a6b5c4123-operator.apk

# ── Initial Seed Credentials ──────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change_me_operator_password

# ── Initial Site Configuration (Optional) ─────────────────────────────────────
SITE_CITY=Pune
SITE_ADDRESS=Camp Area, Pune, Maharashtra
SITE_GATE_INFO=Main Entrance Gate
SITE_CAR_SLOTS=30
SITE_SCOOTER_SLOTS=15
SITE_CAR_RATE=40
SITE_SCOOTER_RATE=20

# ── Migration & Seed Controls ─────────────────────────────────────────────────
RUN_MIGRATIONS=true
RUN_SEED=true
