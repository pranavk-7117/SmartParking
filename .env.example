# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/parkit?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="replace_this_with_a_random_64char_string_in_production"
JWT_EXPIRES_IN="12h"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# ── CORS (comma-separated origins allowed to call the API) ────────────────────
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Seed Credentials (REQUIRED before running prisma db seed) ─────────────────
# These are read by prisma/seed.ts — never commit real values to git
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_strong_admin_password"
OPERATOR_USERNAME="operator"
OPERATOR_PASSWORD="change_me_strong_operator_password"

# ── Site Configuration (optional overrides for seed) ─────────────────────────
SITE_CITY="Pune"
SITE_ADDRESS="Camp Area, Pune, Maharashtra"
SITE_GATE_INFO="Main Entrance Gate"
SITE_CAR_SLOTS="30"
SITE_SCOOTER_SLOTS="15"
SITE_CAR_RATE="40"
SITE_SCOOTER_RATE="20"

# ── Security ──────────────────────────────────────────────────────────────────
MFA_ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
APK_DOWNLOAD_SECRET_PATH="/distribution/replace_with_random_path-operator.apk"
